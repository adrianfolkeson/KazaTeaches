# Required for anything that calls Claude (grading, generation, evals).
ANTHROPIC_API_KEY=sk-ant-...

# Postgres (Supabase: Project Settings -> Database -> Connection string).
# Unset => in-memory store, data is lost on restart. The app says so loudly at startup.
DATABASE_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres

# Model split (§5 cost architecture). Override to experiment.
KT_GRADING_MODEL=claude-opus-5
KT_GENERATION_MODEL=claude-sonnet-5
KT_CONCEPT_MODEL=claude-opus-5

# Spend cap (app/budget.py). The cap is hard: when this month's spend reaches it,
# every paid call is refused with HTTP 402 until the calendar month rolls over.
# The target is advisory — crossing it only changes what /api/budget reports.
# Measured cost: ~$0.011 per review, ~$0.067 per concept at import.
KT_MONTHLY_BUDGET_USD=20
KT_MONTHLY_TARGET_USD=10

# One sitting (app/scheduling.py). Whichever cap binds first ends the day.
KT_SESSION_MAX_ITEMS=20
KT_SESSION_MAX_MINUTES=25
# How many times one item may be asked in a single sitting. An item still
# unclear on the third try today belongs to tomorrow, not to the next six minutes.
KT_SESSION_MAX_PER_ITEM=3

# FSRS. Fuzzing spreads a same-day import across different days; it is also what
# makes scheduling unrepeatable, so tests build their own unfuzzed scheduler.
KT_FSRS_FUZZ=1
# py-fsrs defaults to 36500 days, which for one course is the same as deleting it.
KT_FSRS_MAX_INTERVAL_DAYS=365

# Access gate (app/auth.py). Unset = every endpoint open, which is right locally
# and wrong in production. In production this is a platform secret.
KT_ACCESS_KEY=
